# ──────────────────────────────────────────────────────────────────────────────
# Jane Communication Automation — Environment Variables
#
# Copy this file to `.env` and fill in the values.
# In production (Railway), set these as service-level environment variables.
# Never commit the populated `.env` file to version control.
#
# Field names match `backend/app/config.py` exactly. Anything not listed here
# is unused — if you find a stray var in some old config, delete it.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# In production: APP_ENV=production. The config validator hard-fails on boot if
# you leave APP_SECRET_KEY at the dev default while APP_ENV=production.
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info                     # debug | info | warning | error

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# In Railway, this is provided by the Postgres service plugin — copy the value
# from the service's "Connect" tab. Format must use the psycopg2 dialect.
DATABASE_URL=postgresql+psycopg2://jane_user:jane_pass@localhost:5432/jane_automation

# ── docker-compose only — NOT used by the backend ─────────────────────────────
# These exist solely so docker-compose can stand up a local Postgres container.
# Railway and bare-metal deployments can ignore them.
POSTGRES_DB=jane_automation
POSTGRES_USER=jane_user
POSTGRES_PASSWORD=jane_pass

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_TTL_HOURS=8

# ── LLM provider ──────────────────────────────────────────────────────────────
# PRODUCTION RUNS ANTHROPIC. The 2026-05-14 product call approved Anthropic
# Claude for all email AI (categorization + drafting); the earlier
# RunPod/Gemma plan is now an OPTIONAL self-hosted path kept for flexibility.
#
# Provider options:
#   anthropic     — uses the anthropic SDK against Claude. This is the
#                    production configuration. Requires ANTHROPIC_API_KEY.
#   openai_compat — uses the openai SDK against any OpenAI-compatible
#                    endpoint (RunPod serverless/pod, OpenAI proper, vLLM,
#                    llama.cpp server, …). Requires the three LLM_* values
#                    below. Pair with the RunPod orchestrator section further
#                    down if the endpoint is a stop/startable RunPod pod.
LLM_PROVIDER=anthropic

# Used when LLM_PROVIDER=openai_compat:
#   LLM_API_KEY     = API key for the endpoint. NOTE: this same key is also
#                     used as the RunPod ACCOUNT key by the pod orchestrator
#                     (start/stop/status REST calls) when RUNPOD_POD_ID is set.
#   LLM_BASE_URL    = e.g. https://api.runpod.ai/v2/<endpoint-id>/openai/v1
#   LLM_MODEL       = e.g. google/gemma-2-27b-it (matches the deployed model)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Per-request timeout shared by both providers.
LLM_TIMEOUT=30.0

# ── Anthropic-specific (used when LLM_PROVIDER=anthropic) ─────────────────────
# Get a key from https://console.anthropic.com → Settings → API Keys.
# Boot fails if APP_ENV=production and this key starts with "sk-ant-placeholder".
ANTHROPIC_API_KEY=sk-ant-placeholder-replace-me
CLAUDE_MODEL=claude-sonnet-4-5

# Daily token budget across all LLM calls (categorization + drafting), resets
# at UTC midnight. Once exceeded, categorization falls back to the rules
# engine and drafting pauses for the rest of the day. Set to 0 to disable.
# Heads-up: bulk reprocessing scripts can exhaust this in one run.
DAILY_TOKEN_BUDGET=1000000

# SHADOW_MODE gates AUTO-SEND ONLY. Drafts are still generated and staff can
# still review/approve/send manually — but the system will never send an
# email on its own while this is true. Production runs SHADOW_MODE=true.
# (Auto-send additionally requires the auto_send_enabled system setting —
# both gates must open before anything sends without a human.)
SHADOW_MODE=false

# Reflect in-app folder filing into the real Outlook mailbox (create a client
# folder under Inbox + move the thread's inbound messages). Default off = DB
# label only, no mailbox writes. Enable only after a supervised live test.
OUTLOOK_FOLDER_SYNC=false

# ── Email Provider ────────────────────────────────────────────────────────────
# Set EMAIL_PROVIDER to "msgraph" (production — Microsoft 365 via Graph API)
# or "imap" (Gmail, free Outlook, etc.). Only fill in the credentials for your
# chosen provider — the other set can stay blank.
EMAIL_PROVIDER=msgraph

# MS Graph (Azure app registration with Mail.Read + Mail.Send + Mail.ReadWrite
# application permissions, admin-consented).
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_TENANT_ID=
MSGRAPH_MAILBOX=jane@yourdomain.com

# IMAP / SMTP. IMPORTANT: IMAP_USERNAME and SMTP_USERNAME MUST match — the
# config validator rejects mismatches because they break SPF/DKIM alignment.
# Note: spam/delete mailbox mirroring (move_message) is implemented for
# MS Graph only; the IMAP provider does not support it.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USERNAME=jane@yourdomain.com
IMAP_PASSWORD=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=jane@yourdomain.com
SMTP_PASSWORD=

# ── Polling ───────────────────────────────────────────────────────────────────
EMAIL_POLL_INTERVAL_SECONDS=60

# ── Notifications ─────────────────────────────────────────────────────────────
# At least one of NOTIFY_LOG_FILE or SLACK_WEBHOOK_URL is recommended so urgent
# items aren't missed. Both can be enabled simultaneously.
NOTIFY_LOG_FILE=
SLACK_WEBHOOK_URL=

# ── Draft Generation ──────────────────────────────────────────────────────────
DRAFT_TEMPERATURE=0.3
DRAFT_MAX_TOKENS=1024
DRAFT_AUTO_GENERATE=true
FIRM_NAME=Schilmoeller & Schoenfield, PC
FIRM_OWNER_NAME=Jane Schilmoeller
FIRM_OWNER_EMAIL=jane@schilcpa.com
# Jane's email signature is NOT an env var — it lives in the database
# (system_settings.draft_signature, editable in the Settings UI) and is
# appended to every AI draft and composed email in code.

# ── RunPod orchestrator (OPTIONAL — self-hosted LLM only) ─────────────────────
# Only relevant when LLM_PROVIDER=openai_compat against a RunPod POD (not
# serverless). The orchestrator auto-starts the pod before draft generation
# and a watchdog auto-stops it after idling, so you only pay for active use.
# Leave RUNPOD_POD_ID empty to disable all of this (the Anthropic path
# ignores it entirely). The orchestrator authenticates to RunPod's REST API
# with LLM_API_KEY (see the LLM section above).
RUNPOD_POD_ID=
RUNPOD_IDLE_TIMEOUT_SECONDS=300        # stop pod after 5 min without a draft
RUNPOD_DAILY_CAP_HOURS=10              # hard cap on pod uptime per UTC day
RUNPOD_WATCHDOG_INTERVAL_SECONDS=60    # how often the idle check runs
RUNPOD_START_WAIT_TIMEOUT_SECONDS=300  # max wait for cold start before fallback
RUNPOD_HEALTH_PROBE_TIMEOUT_SECONDS=10 # /v1/models probe timeout
# If the pod fails to start or respond, fall back to Anthropic for that draft
# (requires ANTHROPIC_API_KEY). Set false to escalate-on-failure instead.
ALLOW_CLAUDE_FALLBACK=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. In production, set this to
# your real frontend URL only — preflight rejects values containing localhost.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Trusted Proxies ───────────────────────────────────────────────────────────
# Comma-separated list of proxy IPs whose X-Forwarded-For header is trusted.
# In Railway, set this to the platform's edge IP (or leave blank to fall back
# to the direct connection IP — safer default if you don't know the IP).
TRUSTED_PROXIES=

# ── Frontend Build Arg (Next.js) ──────────────────────────────────────────────
# Inlined at build time — must be passed as a Docker build-arg, not a runtime
# environment variable. In Railway, set it under "Build" on the frontend
# service, not "Variables".
NEXT_PUBLIC_API_URL=http://localhost:8001

# ── First Admin Account ───────────────────────────────────────────────────────
# Used by `python scripts/seed_admin.py` on first boot. The seed script is
# idempotent — re-runs on subsequent deploys are no-ops.
ADMIN_EMAIL=jane@yourdomain.com
ADMIN_NAME=Jane
ADMIN_PASSWORD=change-me-before-deploying
